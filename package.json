{
  "name": "cypress-automation-framework-demo",
  "version": "1.0.0",
  "description": "A production-style Cypress (JavaScript) E2E + API automation framework demo — Page Object Model, fixtures, tag-based smoke/regression filtering, Mochawesome reporting, and a full GitHub Actions pipeline with quality gates. Ships a self-contained demo web app + mock API so the whole suite runs offline in CI.",
  "author": "",
  "license": "MIT",
  "keywords": [
    "cypress",
    "automation",
    "e2e",
    "api-testing",
    "page-object-model",
    "ci-cd",
    "quality-gates",
    "mochawesome"
  ],
  "scripts": {
    "start:app": "http-server app -p 8080 -c-1 --silent",
    "start:api": "node mock-api/server.js",
    "start": "concurrently -k -n APP,API -c blue,magenta \"npm:start:app\" \"npm:start:api\"",
    "clean-reports": "rimraf cypress/screenshots cypress/videos mochawesome.json mochawesome-report",
    "cy:open": "cypress open --config-file cypress.local.config.js",
    "cy:open:smoke": "cypress open --config-file cypress.local.config.js --env grep=@smoke",
    "cy:run": "cypress run --config-file cypress.local.config.js",
    "cy:run:smoke": "cypress run --config-file cypress.local.config.js --env grep=@smoke",
    "cy:run:regression": "cypress run --config-file cypress.local.config.js --env grep=@regression",
    "cy:run:single": "cypress run --config-file cypress.local.config.js --spec",
    "merge-reports": "mochawesome-merge \"mochawesome-report/.jsons/*.json\" > mochawesome.json",
    "generate-report": "marge mochawesome.json --reportDir mochawesome-report --inline",
    "serve-report": "http-server mochawesome-report -p 9000",
    "report": "npm run merge-reports && npm run generate-report",
    "test": "start-server-and-test start \"http://localhost:8080|http://localhost:3001/health\" cy:run",
    "test:smoke": "start-server-and-test start \"http://localhost:8080|http://localhost:3001/health\" cy:run:smoke",
    "test:ci": "npm run clean-reports && start-server-and-test start \"http://localhost:8080|http://localhost:3001/health\" cy:run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@bahmutov/cy-grep": "^2.1.0",
    "@testing-library/cypress": "^10.1.0",
    "concurrently": "^9.1.2",
    "cypress": "^15.15.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "eslint": "^8.57.1",
    "eslint-plugin-cypress": "^3.6.0",
    "http-server": "^14.1.1",
    "json-server": "^0.17.4",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "start-server-and-test": "^2.0.10"
  }
}
